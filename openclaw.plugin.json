                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "deny": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "additionalProperties": false
                },
                "enabled": {
                  "type": "boolean"
                },
                "engage": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "dm",
                      "mention",
                      "assignment",
                      "checkin",
                      "conversation",
                      "activity"
                    ]
                  }
                },
                "allowFrom": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      }
                    ]
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "engage": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "dm",
                "mention",
                "assignment",
                "checkin",
                "conversation",
                "activity"
              ]
            }
          },
          "webhookSecret": {
            "type": "string"
          },
          "webhooks": {
            "type": "object",
            "properties": {
              "payloadUrl": {
                "type": "string",
                "format": "uri"
              },
              "projects": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "types": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "autoRegister": {
                "type": "boolean"
              },
              "deactivateOnStop": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "oauth": {
            "type": "object",
            "properties": {
              "clientId": {
                "type": "string"
              },
              "clientSecret": {
                "type": "string"
              }
            },
            "required": [
              "clientId"
            ],
            "additionalProperties": false
          },
          "polling": {
            "type": "object",
            "properties": {
              "activityIntervalMs": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "readingsIntervalMs": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "assignmentsIntervalMs": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "additionalProperties": false
          },
          "retry": {
            "type": "object",
            "properties": {
              "maxAttempts": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "baseDelayMs": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "maxDelayMs": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "jitter": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "circuitBreaker": {
            "type": "object",
            "properties": {
              "threshold": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "cooldownMs": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "additionalProperties": false
          },
          "safetyNet": {
            "type": "object",
            "properties": {
              "projects": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "intervalMs": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "additionalProperties": false
          },
          "reconciliation": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "intervalMs": {
                "type": "number",
                "exclusiveMinimum": 0
