              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "tokenFile": {
                  "type": "string"
                },
                "token": {
                  "type": "string"
                },
                "personId": {
                  "type": "string"
                },
                "displayName": {
                  "type": "string"
                },
                "attachableSgid": {
                  "type": "string"
                },
