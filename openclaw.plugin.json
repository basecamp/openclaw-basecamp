{
  "id": "basecamp",
  "name": "Basecamp",
  "description": "Campfire chats, card tables, to-do lists, check-ins, pings — every Basecamp surface as a live agent interaction point.",
  "version": "0.1.0",
  "icon": "https://cdn.simpleicons.org/basecamp",
  "channels": [
    "basecamp"
  ],
  "activation": {
    "onStartup": false,
    "onChannels": [
      "basecamp"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "contracts": {
    "tools": [
      "basecamp_create_todo",
      "basecamp_complete_todo",
      "basecamp_reopen_todo",
      "basecamp_read_history",
      "basecamp_add_boost",
      "basecamp_move_card",
      "basecamp_post_message",
      "basecamp_answer_checkin",
      "basecamp_api_read",
      "basecamp_api_write"
    ]
  },
  "toolMetadata": {
    "basecamp_create_todo": {
      "sideEffecting": true
    },
    "basecamp_complete_todo": {
      "sideEffecting": true
    },
    "basecamp_reopen_todo": {
      "sideEffecting": true
    },
    "basecamp_read_history": {
      "replaySafe": true
    },
    "basecamp_add_boost": {
      "sideEffecting": true
    },
    "basecamp_move_card": {
      "sideEffecting": true
    },
    "basecamp_post_message": {
      "sideEffecting": true
    },
    "basecamp_answer_checkin": {
      "sideEffecting": true
    },
    "basecamp_api_read": {
      "replaySafe": true
    },
    "basecamp_api_write": {
      "sideEffecting": true
    }
  },
  "backupResources": [
    {
      "disposition": "include",
      "scope": "state",
      "relativePath": "plugins/basecamp"
    }
  ],
  "channelConfigs": {
