{
  "name": "@37signals/openclaw-basecamp",
  "version": "0.1.0",
  "description": "OpenClaw Basecamp channel plugin \u2014 Campfire, cards, todos, check-ins, pings",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basecamp/openclaw-basecamp.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "!dist/scripts/",
    "openclaw.plugin.json"
  ],
  "engines": {
    "node": ">=22.22.3 <23 || >=24.15.0 <25 || >=25.9.0"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist coverage *.tsbuildinfo",
    "prepublishOnly": "npm run build",
    "check": "npm run typecheck && npm run lint && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "manifest:gen": "npm run build && node dist/scripts/generate-manifest.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@vitest/coverage-v8": "^4.1.10",
    "openclaw": "2026.8.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "channel": {
      "id": "basecamp",
      "label": "Basecamp",
      "selectionLabel": "Basecamp (Campfire, Cards, Todos, Check-ins, Pings)",
      "docsPath": "/channels/basecamp",
      "docsLabel": "basecamp",
      "blurb": "Campfire chats, card tables, to-do lists, check-ins, pings \u2014 every Basecamp surface as a live agent interaction point.",
      "detailLabel": "Basecamp (Campfire, Cards, Todos, Check-ins, Pings)",
      "systemImage": "building.2",
      "markdownCapable": true,
      "aliases": [
        "bc"
      ],
      "commands": {
        "nativeCommandsAutoEnabled": false,
        "nativeSkillsAutoEnabled": false
      },
      "doctorCapabilities": {
        "dmAllowFromMode": "topOnly",
        "groupModel": "route"
      },
      "setup": {
        "fields": [
          {
            "key": "token",
            "kind": "string",
            "sensitive": true,
            "cli": {
              "flags": "--token <token>",
              "description": "Inline OAuth token (prefer --token-file)"
            }
          },
          {
            "key": "tokenFile",
            "kind": "string",
            "cli": {
              "flags": "--token-file <path>",
              "description": "Path to file containing OAuth token"
            },
            "sensitive": true
          },
          {
            "key": "personId",
            "kind": "string",
            "cli": {
              "flags": "--person-id <id>",
              "description": "Basecamp person ID (numeric)"
            }
          },
          {
            "key": "basecampAccountId",
            "kind": "string",
            "cli": {
              "flags": "--basecamp-account-id <id>",
              "description": "Numeric Basecamp account ID"
            }
          },
          {
            "key": "oauthClientId",
            "kind": "string",
            "cli": {
              "flags": "--oauth-client-id <id>",
              "description": "Basecamp OAuth app client ID for browser-based login"
            }
          },
          {
            "key": "oauthClientSecret",
            "kind": "string",
            "sensitive": true,
            "cli": {
              "flags": "--oauth-client-secret <secret>",
              "description": "Basecamp OAuth app client secret"
            }
          },
          {
            "key": "cliProfile",
            "kind": "string",
            "cli": {
              "flags": "--cli-profile <profile>",
              "description": "Basecamp CLI profile for identity discovery during setup"
            }
          }
        ]
      }
    },
    "install": {
      "npmSpec": "@37signals/openclaw-basecamp",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.8.1"
    },
    "compat": {
      "pluginApi": ">=2026.8.1"
    },
    "build": {
      "openclawVersion": "2026.8.1",
      "pluginSdkVersion": "2026.8.1"
    },
    "setupEntry": "./dist/setup-entry.js"
  },
  "dependencies": {
    "@37signals/basecamp": "0.13.0",
    "zod": "4.4.3",
    "typebox": "1.3.16"
  },
  "peerDependencies": {
    "openclaw": ">=2026.8.1"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  }
}
